; Native ABI 2 uses a pointer and length without Wasm address packing.
; These properties cover arithmetic only. They do not prove pointer validity or allocator ownership.
(set-logic QF_BV)
(set-option :incremental true)
(declare-const pointer (_ BitVec 64))
(declare-const length (_ BitVec 64))
(declare-const limit (_ BitVec 32))
(declare-const status (_ BitVec 32))
(define-fun accepted () Bool
 (and (bvule status (_ bv1 32))
      (distinct pointer (_ bv0 64))
      (bvugt length (_ bv0 64))
      (bvule length ((_ zero_extend 32) limit))))
(push 1)
(assert accepted)
(assert (not (bvsge length (_ bv0 64))))
(check-sat)
(pop 1)
(push 1)
(assert accepted)
(assert (not (= ((_ zero_extend 32) ((_ extract 31 0) length)) length)))
(check-sat)
(pop 1)
(declare-const handle (_ BitVec 64))
(define-fun next () (_ BitVec 64) (bvadd handle (_ bv1 64)))
(push 1)
(assert (and (bvugt handle (_ bv0 64)) (bvult handle #xffffffffffffffff)))
(assert (not (and (bvugt next handle) (distinct next (_ bv0 64)))))
(check-sat)
(pop 1)
